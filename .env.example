# Copy to .env and fill in. Never commit .env.

# Data locations (defaults point at ./data, which docker-compose mounts)
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Today's date as YYYY-MM-DD. If empty, the system date is used.
APP_TODAY=

# LLM settings (used from Leap 3 onwards)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
